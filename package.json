{
  "name": "p11-onboarding-portal",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost --port 3000",
    "build": "vite build",
    "preview": "vite preview --host localhost --port 3000",
    "start": "node server.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "etl:accelo": "python accelo_etl.py",
    "etl:accelo:full": "python accelo_etl.py --full",
    "check:sql-invariants": "node scripts/check-sql-invariants.mjs",
    "check:db-company-consistency": "node scripts/check-db-company-consistency.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^8.0.13",
    "vitest": "latest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4"
  }
}
